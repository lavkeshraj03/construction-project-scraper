# ============================================================
# Construction Project Scraper — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Paths ---
DATABASE_PATH=data/projects.db
OUTPUT_PATH=output/construction_projects.xlsx
LOG_PATH=logs/scraper.log
RAW_DATA_DIR=data/raw

# --- Scraping limits ---
MAX_PROJECTS_PER_SOURCE=100
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.0
MAX_RETRIES=3

# --- AI Extraction (disabled by default) ---
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini

# --- Enable/Disable Sources ---
ENABLE_MAHARERA=true
ENABLE_CPPP=true
ENABLE_GEM=true
ENABLE_MAHATENDER=true
ENABLE_MUNICIPAL=true
ENABLE_SMART_CITY=true
ENABLE_BUILDER_WEB=true

# --- Optional: Builder website URLs (comma-separated) ---
BUILDER_WEB_URLS=

# --- Optional: Municipal source URLs (comma-separated) ---
MUNICIPAL_URLS=
